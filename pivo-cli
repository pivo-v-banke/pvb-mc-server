#!/usr/bin/env python3

from __future__ import annotations

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
VENV_PY = HERE / ".venv" / "bin" / "python"

# Prefer project venv to ensure dependencies are available.
if os.environ.get("PIVO_NO_VENV") != "1" and VENV_PY.exists() and Path(sys.executable) != VENV_PY:
    os.execv(str(VENV_PY), [str(VENV_PY), str(__file__), *sys.argv[1:]])

import sys

from pivo.cli import main


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

